{
  "name": "scorebug-desktop",
  "version": "1.2.2",
  "private": true,
  "description": "A live NFL scorebug that floats above your desktop.",
  "productName": "Scorebug",
  "main": "main.cjs",
  "author": "Aarav Shah",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test geometry.test.cjs hover.test.cjs details-lifecycle.test.cjs updates.test.cjs",
    "test:smoke": "node smoke-launcher.cjs",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.aarav.scorebug",
    "productName": "Scorebug",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "geometry.cjs",
      "hover.cjs",
      "details-lifecycle.cjs",
      "updates.cjs",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "scorebug",
        "filter": [
          "server.mjs",
          "package.json",
          "public/**/*",
          "lib/**/*",
          "api/**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Scorebug-Portable-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Scorebug-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Scorebug"
    },
    "publish": {
      "provider": "github",
      "owner": "aaraven99",
      "repo": "scorebug",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  }
}
