{
  "name": "scorebug-desktop",
  "version": "2.1.4",
  "private": true,
  "description": "Live sports scores, favorite teams and broadcast styles in a floating desktop companion.",
  "productName": "Scorebug",
  "main": "main.cjs",
  "author": "Aarav Shah",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test geometry.test.cjs hover.test.cjs details-lifecycle.test.cjs fullscreen.test.cjs updates.test.cjs preferences.test.cjs",
    "test:smoke": "node smoke-launcher.cjs",
    "dist:win": "electron-builder --win --x64 --publish never",
    "build:mac-helper": "node build-macos.cjs",
    "dist:mac": "node build-macos.cjs && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.aarav.scorebug",
    "productName": "Scorebug",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "geometry.cjs",
      "hover.cjs",
      "details-lifecycle.cjs",
      "fullscreen.cjs",
      "updates.cjs",
      "assets/**/*",
      "package.json",
      "preferences.cjs",
      "smoke.cjs"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "scorebug",
        "filter": [
          "server.mjs",
          "package.json",
          "public/**/*",
          "lib/**/*",
          "api/**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Scorebug-Portable-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Scorebug-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Scorebug"
    },
    "publish": {
      "provider": "github",
      "owner": "aaraven99",
      "repo": "scorebug",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.sports",
      "icon": "assets/icon.png",
      "minimumSystemVersion": "13.0",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Scorebug-Mac-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "notarize": false,
      "extraResources": [
        {
          "from": "native/bin/mac-mouse-release",
          "to": "mac-mouse-release"
        }
      ]
    },
    "dmg": {
      "title": "Scorebug ${version}",
      "backgroundColor": "#101512",
      "window": {
        "width": 540,
        "height": 340
      },
      "contents": [
        {
          "x": 150,
          "y": 160
        },
        {
          "x": 390,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  }
}
